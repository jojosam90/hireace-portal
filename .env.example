# Copy to .env.local for local use; on Vercel set these in the project's settings.

# Sign-in: make the hash with `pnpm hash-password "the password"`
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Several people, each with a card on the login page and their own password. When set, this
# replaces the two lines above. One line of JSON:
# ADMIN_ACCOUNTS=[{"username":"farah","name":"Farah Lee","role":"Manager","passwordHash":"..."}]
ADMIN_ACCOUNTS=

# Fills the password in when a card is tapped: for this PC or a demo ONLY. It sends the real
# password to anyone who opens the login page, so anyone with the address can sign in, and restart
# or deactivate workstations. For the single account (for ADMIN_ACCOUNTS, add "prefillPassword").
ADMIN_PREFILL_PASSWORD=

# Any long random string: signs the sign-in cookie
SESSION_SECRET=

# The same text as installer/license-secret.txt: workstations join with their license code
LICENSE_SECRET=

# Lets installer/publish-release.ps1 add a release. It cannot sign one.
RELEASE_PUBLISH_KEY=

# Postgres (for example Neon). Required on Vercel. Without it, on this PC only, a local
# database in .data/ is used.
DATABASE_URL=

# Optional: spending alerts by email, through Resend. Without your own verified domain Resend
# only delivers to the address of its own account.
RESEND_API_KEY=
ALERT_EMAIL_FROM=HireAce Alerts <onboarding@resend.dev>

# Optional: the real bill from OpenAI next to HireAce's estimate. An Admin key, which can
# also manage the organization: keep it here only and never in an installer.
OPENAI_ADMIN_KEY=
